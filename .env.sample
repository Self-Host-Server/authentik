# ==============================================================
# authentik - .env.sample
# Copy this file to .env and fill in your values
# ==============================================================

# --------------------------------------------------------------
# PostgreSQL
# --------------------------------------------------------------
PG_USER=authentik
PG_PASS=change_me_strong_db_password
PG_DB=authentik

# --------------------------------------------------------------
# authentik
# --------------------------------------------------------------
# Generate with: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=change_me_generate_a_long_random_string

# --------------------------------------------------------------
# authentik Image
# --------------------------------------------------------------
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.2.1

# --------------------------------------------------------------
# Ports (change if you have conflicts)
# --------------------------------------------------------------
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# --------------------------------------------------------------
# LDAP Outpost
# Get this token from: Admin Interface → Applications → Outposts
# → View Deployment Info → Token
# --------------------------------------------------------------
AUTHENTIK_LDAP_TOKEN=change_me_paste_outpost_token_here

# --------------------------------------------------------------
# Optional: Email (for password resets, notifications)
# --------------------------------------------------------------
# AUTHENTIK_EMAIL__HOST=smtp.example.com
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=your@email.com
# AUTHENTIK_EMAIL__PASSWORD=your_email_password
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=authentik@example.com
